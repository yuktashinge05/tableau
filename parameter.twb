      <aliases enabled='yes' />
      <column caption='Review performance scores' datatype='integer' name='[Calculation_0048438681911296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]* [Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_0048438683717633]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Price] &gt; 300 THEN &quot;luxury&quot; ELSEIF [Price] &gt; 150 THEN &quot;Standard&quot; ELSE &quot;budget&quot; END' />
      </column>
      <column caption='Count Of Hotels' datatype='integer' name='[Calculation_0048438686715906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='HOST STATUS' datatype='string' name='[Calculation_0048438690619395]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt; TODAY() THEN &quot;ACTIVE HOST&quot; ELSE &quot;NEW HOST&quot; END' />
      </column>
      <column caption='REVIEW CATEGORY' datatype='string' name='[Calculation_0048438691364868]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] = 100 THEN &quot;HIGHLY REVIEWD&quot;&#13;&#10;ELSE &quot;LESS REVIEWD&quot; END' />
      </column>
      <column caption='PRICE FILTER CATEGORY' datatype='string' name='[Calculation_0048438693371911]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0048438692724742]&#13;&#10;THEN &quot;ABOVE LIMT&quot;&#13;&#10;ELSE &quot;BELOW LIMIT&quot;&#13;&#10;END' />
      </column>
      <column caption='NEW_HOST_SINCE' datatype='date' name='[Calculation_0048438699913225]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='review score rating NEW ' datatype='integer' name='[Calculation_0048438702215178]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Review Scores Rating (bin)],0)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column datatype='integer' hidden='true' name='[Review Scores Rating (bin)]' role='measure' type='quantitative' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
